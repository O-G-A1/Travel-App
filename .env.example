# Optional persistence/authentication. Without these, the app runs in clearly labelled browser demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side AI. Endpoint should accept OpenAI-compatible chat completions.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional WeatherAPI.com credential. Weather stays off until this server-only key is set.
WEATHER_API_KEY=

# Optional product analytics. Keep unset to disable analytics.
# Geoapify Free plan key for the interactive map and explicit place searches. Restrict this key to your app domains.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_APP_NAME=Voyara
