# Optional persistence/authentication. Leave blank to use browser demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side AI provider. Keep the key secret and server-only.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional server-side WeatherAPI.com key for current destination conditions.
WEATHER_API_KEY=

# Optional public map key. Restrict this key to your app domains.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Optional analytics endpoint; leave blank to disable analytics.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_APP_NAME=Voyara
